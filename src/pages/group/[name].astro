---
import Layout from '../../layouts/Layout.astro';
import {
  findGroup,
  getGroupMembers,
  getGroupMemberRole,
  getGroupReports,
  validateGroupName,
} from '../../lib/groups';
import { getCurrentCurator } from '../../lib/auth';

const emojis = [
  '👍', '❤️', '😂', '😮', '😢', '😡', '🎉', '👏', '🔥', '🚀', '💯', '✨',
  '😍', '🤔', '👀', '🙌', '💪', '🤝', '🌟', '❓', '☕', '🍕', '🐶', '🐱',
  '🌈', '🌙', '⚡', '🎵', '💡', '🛠️', '🌿', '🌍',
];

const { name } = Astro.params;
const groupName = typeof name === 'string' ? name : '';
const isValid = validateGroupName(groupName);
const group = isValid ? await findGroup(groupName) : null;
const currentCurator = await getCurrentCurator(Astro.cookies);
const currentUser = currentCurator ? { id: currentCurator.id, username: currentCurator.username } : null;
const role = currentCurator && group ? await getGroupMemberRole(currentCurator.id, groupName) : null;
const isCreator = role === 'creator';
const isMember = isCreator || role === 'member';
const members = isMember && group ? await getGroupMembers(groupName) : [];
const reports = isCreator && currentCurator && group ? await getGroupReports(groupName, currentCurator.id) : [];
const inviteUrl = typeof Astro.url?.origin === 'string' ? `${Astro.url.origin}/group/${groupName}` : `https://openbin.livrasand.com/group/${groupName}`;
---

<Layout title={group?.title ? `${group.title} · openbin` : `${groupName} · openbin`}>
  <section class="flex-1 flex flex-col overflow-hidden p-4">
    <div class="max-w-3xl w-full mx-auto flex flex-col h-full gap-4">
      <header class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold text-main">/{groupName}</h1>
          {group?.title && <p class="text-sm text-muted">{group.title}</p>}
          {group?.description && <p class="text-xs text-muted mt-1">{group.description}</p>}
          {group && (
            <span class="inline-block mt-2 text-[10px] px-1.5 py-0.5 border border-surface-light text-muted">
              {group.access === 'open' ? 'open' : 'moderated'}
            </span>
          )}
        </div>
        <div class="flex items-center gap-2">
          {group && !currentUser && (
            <a
              href="/login"
              class="h-8 border border-surface-light px-3 text-xs font-medium text-main transition hover:bg-surface-light inline-flex items-center"
            >
              Login to join
            </a>
          )}
          {group && currentUser && role === null && (
            <button
              id="join-group-btn"
              type="button"
              class="h-8 border border-primary bg-primary px-3 text-xs font-medium text-white transition hover:bg-primary/90"
            >
              {group.access === 'open' ? 'Join group' : 'Request to join'}
            </button>
          )}
          {group && currentUser && (role === 'member' || role === 'creator') && (
            <>
              <button
                id="invite-btn"
                type="button"
                class="h-8 border border-surface-light bg-surface px-3 text-xs font-medium text-main transition hover:bg-surface-light"
              >
                Invite
              </button>
              <button
                id="leave-group-btn"
                type="button"
                class="h-8 border border-red-400/50 bg-red-400/10 px-3 text-xs font-medium text-red-400 transition hover:bg-red-400/20"
              >
                {role === 'creator' ? 'Dissolve group' : 'Leave group'}
              </button>
            </>
          )}
        </div>
      </header>

      {!isValid && (
        <div class="text-sm text-main bg-red-500/10 border border-red-500/30 p-3">
          Invalid group name. Use 3–64 letters, numbers, underscores or dashes.
        </div>
      )}

      {isValid && !group && (
        <div class="text-sm text-main bg-surface border border-surface-light p-4">
          <p class="font-medium">This group does not exist yet.</p>
          <p class="text-xs text-muted mt-1">
            Create it from <a href="/spaces" class="text-primary hover:underline">/spaces</a>.
          </p>
        </div>
      )}

      {group && role === 'pending' && (
        <div class="text-sm text-main bg-surface border border-surface-light p-3">
          Your membership request is pending approval.
        </div>
      )}

      {group && (role === 'creator' || role === 'member') && (
        <>
          {role === 'creator' && members.some((m) => m.role === 'pending') && (
            <div class="border border-surface-light bg-surface p-3">
              <p class="text-xs font-medium text-main mb-2">Pending requests</p>
              <ul class="space-y-2" id="pending-members">
                {members
                  .filter((m) => m.role === 'pending')
                  .map((m) => (
                    <li class="flex items-center justify-between gap-2 text-xs text-main">
                      <span>{m.username}</span>
                      <button
                        type="button"
                        data-approve={m.curator_id}
                        class="approve-btn h-6 border border-primary bg-primary px-2 text-xs font-medium text-white transition hover:bg-primary/90"
                      >
                        Approve
                      </button>
                    </li>
                  ))}
              </ul>
            </div>
          )}

          {members.length > 0 && (
            <div class="border border-surface-light bg-surface p-3">
              <p class="text-xs font-medium text-main mb-2">Members</p>
              <ul class="flex flex-wrap gap-2 text-xs text-main">
                {members
                  .filter((m) => m.role !== 'pending')
                  .map((m) => (
                    <li class="border border-surface-light bg-background px-2 py-1 text-muted">
                      {m.username} {m.role === 'creator' ? '· creator' : ''}
                    </li>
                  ))}
              </ul>
            </div>
          )}

          {isCreator && reports.length > 0 && (
            <div id="reports-panel" class="border border-red-400/30 bg-red-400/5 p-3">
              <p class="text-xs font-medium text-main mb-2">Message reports</p>
              <ul class="space-y-2 text-xs text-main">
                {reports.map((r) => (
                  <li class="flex items-start justify-between gap-2">
                    <div class="text-muted">
                      <span class="text-main">{r.author}</span>: {r.message_content}
                      <span class="block text-[10px]">
                        Reported by {r.reporter_username || 'unknown'}
                        {r.reason ? ` · ${r.reason}` : ''}
                      </span>
                    </div>
                    <button
                      type="button"
                      data-hide={r.message_id}
                      class="h-6 border border-red-400/50 bg-red-400/10 px-2 text-xs text-red-400 transition hover:bg-red-400/20"
                    >
                      Hide
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="flex-1 overflow-y-auto border border-surface-light bg-surface p-3 min-h-0" id="messages">
            <p id="messages-loading" class="text-center text-sm text-muted py-8">Loading messages...</p>
          </div>

          <form id="message-form" class="flex flex-col gap-2 border border-surface-light bg-surface p-3">
            <p id="reply-indicator" class="hidden text-xs text-muted">
              Replying to message <span id="reply-to-id"></span>
              <button type="button" id="cancel-reply" class="ml-2 text-primary hover:underline">cancel</button>
            </p>
            <input type="hidden" id="message-parent-id" name="parent_id" value="" />
            <textarea
              id="message-content"
              name="content"
              rows="2"
              placeholder="Write a message..."
              required
              class="w-full border border-surface-light bg-background px-3 py-2 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none resize-none"
            ></textarea>
            <p id="message-error" class="hidden text-xs text-red-400"></p>
            <button
              type="submit"
              class="self-end h-8 border border-primary bg-primary px-3 text-xs font-medium text-white transition hover:bg-primary/90"
            >
              Send
            </button>
          </form>
        </>
      )}

      {group && !isMember && role !== 'pending' && (
        <div class="text-sm text-main bg-surface border border-surface-light p-4">
          <p class="font-medium">This is a private group.</p>
          <p class="text-xs text-muted mt-1">
            {currentUser
              ? group.access === 'open'
                ? 'Join the group to participate.'
                : 'Request to join the group.'
              : 'Login to join or request membership.'}
          </p>
        </div>
      )}
    </div>
  </section>

  <div id="reaction-panel" class="fixed inset-0 z-50 hidden bg-black/50 flex items-center justify-center p-4">
    <div class="bg-surface border border-surface-light w-full max-w-md p-4">
      <div class="flex justify-between items-center mb-3">
        <p class="text-sm font-medium text-main">React</p>
        <button type="button" id="close-reaction-panel" class="text-2xl text-muted leading-none">&times;</button>
      </div>
      <div id="reaction-grid" class="grid grid-cols-8 gap-2">
        {emojis.map((emoji) => (
          <button
            type="button"
            data-emoji={emoji}
            class="reaction-emoji text-2xl hover:bg-surface-light p-2 rounded transition"
          >
            {emoji}
          </button>
        ))}
      </div>
      <p class="text-[10px] text-muted mt-3 text-center">
        Fluent Emoji Flat · Microsoft Corporation · MIT License
      </p>
    </div>
  </div>
  <div id="invite-modal" class="fixed inset-0 z-50 hidden bg-black/50 flex items-center justify-center p-4">
    <div class="bg-surface border border-surface-light w-full max-w-md p-4">
      <div class="flex justify-between items-center mb-3">
        <p class="text-sm font-medium text-main">Guest invitation link</p>
        <button type="button" id="close-invite-modal" class="text-2xl text-muted leading-none">&times;</button>
      </div>
      <p class="text-xs text-muted mb-3">
        You can provide the following link to anyone (with registration):
      </p>
      <div class="flex gap-2">
        <input
          id="invite-link-input"
          type="text"
          readonly
          value={inviteUrl}
          class="flex-1 border border-surface-light bg-background px-3 py-2 text-xs text-main focus:outline-none"
        />
        <button
          type="button"
          id="copy-invite-link"
          class="h-8 border border-primary bg-primary px-3 text-xs font-medium text-white transition hover:bg-primary/90"
        >
          Copy
        </button>
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ groupName, isValid, currentUser, role, isCreator }}>
  const isMember = isCreator || role === 'member';
  const joinBtn = document.getElementById('join-group-btn');
  const leaveBtn = document.getElementById('leave-group-btn');
  const messageForm = document.getElementById('message-form');
  const messageContent = document.getElementById('message-content');
  const messageParentId = document.getElementById('message-parent-id');
  const replyIndicator = document.getElementById('reply-indicator');
  const replyToId = document.getElementById('reply-to-id');
  const cancelReply = document.getElementById('cancel-reply');
  const messageError = document.getElementById('message-error');
  const messagesEl = document.getElementById('messages');
  const reactionPanel = document.getElementById('reaction-panel');
  const closeReactionPanel = document.getElementById('close-reaction-panel');
  const reactionGrid = document.getElementById('reaction-grid');
  const inviteBtn = document.getElementById('invite-btn');
  const inviteModal = document.getElementById('invite-modal');
  const closeInviteModal = document.getElementById('close-invite-modal');
  const copyInviteLink = document.getElementById('copy-invite-link');
  const inviteLinkInput = document.getElementById('invite-link-input');
  let selectedMessageId = null;
  const MAX_MESSAGE_PREVIEW = 500;

  function setReply(parentId) {
    if (!messageParentId || !replyIndicator || !replyToId) return;
    messageParentId.value = parentId || '';
    if (parentId) {
      replyToId.textContent = `#${parentId}`;
      replyIndicator.classList.remove('hidden');
    } else {
      replyIndicator.classList.add('hidden');
    }
  }

  if (cancelReply) {
    cancelReply.addEventListener('click', () => setReply(''));
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  const URL_RE = /https?:\/\/[^\s<]+/g;

  function linkifyMessageContent(text) {
    const escaped = escapeHtml(text);
    return escaped.replace(URL_RE, (url) => {
      return `<a href="${url}" target="_blank" rel="noopener nofollow" class="text-primary underline break-all">${url}</a><span class="text-[10px] text-muted ml-1" title="Ten cuidado al abrir enlaces fuera de Openbin">(cuidado)</span>`;
    });
  }

  function renderMessagesHtml(nodes, level = 0) {
    if (!nodes || !nodes.length) return '';
    const indentClass = level > 0 ? 'border-l-2 border-surface-light pl-3 mt-3' : '';
    return `<ul class="space-y-3 ${indentClass}">${nodes
      .map((m) => {
        const toolbarButtons = [
          currentUser ? `<button type="button" data-react="${m.id}" class="toolbar-btn" title="React">😊</button>` : '',
          m.can_edit ? `<button type="button" data-edit="${m.id}" class="toolbar-btn text-xs px-1">edit</button>` : '',
          m.can_delete ? `<button type="button" data-delete="${m.id}" class="toolbar-btn text-xs px-1 text-red-400">delete</button>` : '',
          isCreator ? `<button type="button" data-hide="${m.id}" class="toolbar-btn text-xs px-1 text-yellow-400">hide</button>` : '',
          currentUser && !isCreator ? `<button type="button" data-report="${m.id}" class="toolbar-btn text-xs px-1">report</button>` : '',
        ].filter(Boolean).join('');

        const reactions = m.reactions.length
          ? `<div class="reactions flex flex-wrap gap-1 mt-2">${m.reactions
              .map(
                (r) =>
                  `<button type="button" data-msg-id="${m.id}" data-emoji="${r.emoji}" class="reaction-toggle text-[10px] border border-surface-light px-1.5 py-0.5 ${r.reacted ? 'bg-primary/20 text-primary' : 'text-muted'}">${r.emoji} ${r.count}</button>`
              )
              .join('')}</div>`
          : '';

        const body = m.hidden
          ? `<p class="text-sm text-muted italic">Hidden message: ${escapeHtml(m.hidden_reason || '')}</p>`
          : (() => {
              const isLong = m.content.length > MAX_MESSAGE_PREVIEW;
              const shortText = escapeHtml(m.content.slice(0, MAX_MESSAGE_PREVIEW));
              const fullText = linkifyMessageContent(m.content);
              const readMoreBtn = `<button type="button" class="read-more-btn self-center -mt-5 relative z-10 inline-flex items-center gap-1 rounded-full border border-surface-light bg-surface px-4 py-1 text-xs font-medium text-primary shadow-sm transition hover:bg-primary/10 hover:border-primary/50 hover:shadow" data-read-more="${m.id}">Read more</button>`;
              const textHtml = isLong
                ? `<div class="msg-text flex flex-col text-sm text-main mt-1">
                     <div class="msg-short relative">
                       <span class="block whitespace-pre-wrap break-words">${shortText}</span>
                       <div class="msg-fade absolute bottom-0 left-0 right-0 h-10 bg-gradient-to-t from-[var(--color-background)] to-transparent pointer-events-none"></div>
                     </div>
                     <div class="msg-rest hidden whitespace-pre-wrap break-words">${fullText}</div>
                     ${readMoreBtn}
                   </div>`
                : `<p class="msg-text text-sm text-main whitespace-pre-wrap break-words mt-1">${fullText}</p>`;
              return `${textHtml}
             <form class="edit-form hidden mt-2" data-edit-form="${m.id}">
               <textarea rows="2" required maxlength="10000" class="edit-textarea w-full border border-surface-light bg-background px-3 py-2 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none resize-none">${escapeHtml(m.content)}</textarea>
               <div class="flex gap-2 mt-1">
                 <button type="submit" class="h-6 border border-primary bg-primary px-2 text-xs text-white transition hover:bg-primary/90">Save</button>
                 <button type="button" data-cancel-edit="${m.id}" class="h-6 border border-surface-light bg-surface px-2 text-xs text-main transition hover:bg-surface-light">Cancel</button>
               </div>
               <p class="edit-error hidden text-xs text-red-400 mt-1"></p>
             </form>`;
            })();

        const replyBtn =
          !m.hidden && isMember
            ? `<button type="button" data-reply="${m.id}" class="reply-btn text-[10px] text-primary hover:underline mt-2">reply</button>`
            : '';

        return `
    <li data-id="${m.id}" data-curator="${m.curator_id ?? ''}" class="group-message relative">
      <div class="message-content relative border border-surface-light bg-background p-3">
        ${toolbarButtons ? `<div class="message-toolbar absolute top-1 right-1 hidden gap-1 bg-surface border border-surface-light px-1 py-0.5 shadow-sm">${toolbarButtons}</div>` : ''}
        <p class="text-[10px] text-muted">
          by <span class="text-main">${escapeHtml(m.author)}</span>
          · <time>${new Date(m.created_at).toLocaleString()}</time>
          ${m.updated_at !== m.created_at && !m.hidden ? '<span class="italic ml-1">(edited)</span>' : ''}
        </p>
        ${body}
        ${reactions}
        ${replyBtn}
      </div>
      ${renderMessagesHtml(m.children, level + 1)}
    </li>`;
      })
      .join('')}</ul>`;
  }

  function toggleReadMore(messageId, btn) {
    const msg = document.querySelector(`.group-message[data-id="${messageId}"]`);
    if (!msg) return;
    const short = msg.querySelector('.msg-short');
    const rest = msg.querySelector('.msg-rest');
    if (rest && rest.classList.contains('hidden')) {
      rest.classList.remove('hidden');
      if (short) short.classList.add('hidden');
      btn.textContent = 'Read less';
    } else {
      if (rest) rest.classList.add('hidden');
      if (short) short.classList.remove('hidden');
      btn.textContent = 'Read more';
    }
  }

  function isInteracting() {
    return (
      (reactionPanel && !reactionPanel.classList.contains('hidden')) ||
      document.querySelector('.edit-form:not(.hidden)') !== null
    );
  }

  function attachToolbarListeners() {
    document.querySelectorAll('.group-message').forEach((msg) => {
      const toolbar = msg.querySelector('.message-toolbar');
      if (!toolbar) return;
      let timer = null;
      function show() {
        toolbar.classList.remove('hidden');
        toolbar.classList.add('flex');
      }
      function hide() {
        toolbar.classList.add('hidden');
        toolbar.classList.remove('flex');
      }
      msg.addEventListener('mouseenter', () => {
        show();
        if (timer) clearTimeout(timer);
        timer = setTimeout(hide, 10000);
      });
      msg.addEventListener('mouseleave', () => {
        if (timer) clearTimeout(timer);
        hide();
      });
    });
  }

  async function loadMessages() {
    if (!messagesEl) return;
    try {
      const res = await fetch(`/api/groups/${encodeURIComponent(groupName)}/messages`);
      if (!res.ok) return;
      const data = await res.json();
      const messages = Array.isArray(data.messages) ? data.messages : [];

      messagesEl.innerHTML = messages.length
        ? renderMessagesHtml(messages)
        : '<p class="text-center text-sm text-muted py-8">No messages yet.</p>';
      attachToolbarListeners();

      // Always scroll to the newest message at the bottom.
      messagesEl.scrollTop = messagesEl.scrollHeight;
    } catch (err) {
      console.error('loadMessages error:', err);
    }
  }

  function openReactionPanel(messageId) {
    selectedMessageId = messageId;
    if (reactionPanel) reactionPanel.classList.remove('hidden');
  }

  function closeReaction() {
    selectedMessageId = null;
    if (reactionPanel) reactionPanel.classList.add('hidden');
  }

  if (closeReactionPanel) {
    closeReactionPanel.addEventListener('click', closeReaction);
  }
  if (reactionPanel) {
    reactionPanel.addEventListener('click', (e) => {
      if (e.target === reactionPanel) closeReaction();
    });
  }

  function openInviteModal() {
    if (inviteModal) inviteModal.classList.remove('hidden');
  }

  function closeInvite() {
    if (inviteModal) inviteModal.classList.add('hidden');
  }

  if (inviteBtn) {
    inviteBtn.addEventListener('click', openInviteModal);
  }
  if (closeInviteModal) {
    closeInviteModal.addEventListener('click', closeInvite);
  }
  if (inviteModal) {
    inviteModal.addEventListener('click', (e) => {
      if (e.target === inviteModal) closeInvite();
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeReaction();
      closeInvite();
    }
  });

  if (copyInviteLink && inviteLinkInput) {
    copyInviteLink.addEventListener('click', async () => {
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(inviteLinkInput.value);
        } else {
          inviteLinkInput.select();
          document.execCommand('copy');
        }
        const original = copyInviteLink.textContent;
        copyInviteLink.textContent = 'Copied';
        setTimeout(() => { copyInviteLink.textContent = original; }, 1500);
      } catch (err) {
        console.error('Copy failed:', err);
      }
    });
  }

  if (reactionGrid) {
    reactionGrid.addEventListener('click', async (e) => {
      const btn = e.target.closest('.reaction-emoji');
      if (!btn || !selectedMessageId || !btn.dataset.emoji) return;
      try {
        const res = await fetch(`/api/groups/${encodeURIComponent(groupName)}/messages/${selectedMessageId}/reactions`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ emoji: btn.dataset.emoji }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Could not react');
        closeReaction();
        await loadMessages();
      } catch (err) {
        alert(err.message);
      }
    });
  }

  function openEditForm(messageId) {
    const msg = document.querySelector(`.group-message[data-id="${messageId}"]`);
    if (!msg) return;
    const text = msg.querySelector('.msg-text');
    const form = msg.querySelector('.edit-form');
    if (text) text.classList.add('hidden');
    if (form) {
      form.classList.remove('hidden');
      const textarea = form.querySelector('.edit-textarea');
      if (textarea) textarea.focus();
    }
  }

  function closeEditForm(messageId) {
    const msg = document.querySelector(`.group-message[data-id="${messageId}"]`);
    if (!msg) return;
    const text = msg.querySelector('.msg-text');
    const form = msg.querySelector('.edit-form');
    if (text) text.classList.remove('hidden');
    if (form) form.classList.add('hidden');
    const err = form?.querySelector('.edit-error');
    if (err) {
      err.textContent = '';
      err.classList.add('hidden');
    }
  }

  async function toggleReaction(messageId, emoji) {
    try {
      const res = await fetch(`/api/groups/${encodeURIComponent(groupName)}/messages/${messageId}/reactions`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ emoji }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Could not react');
      await loadMessages();
    } catch (err) {
      alert(err.message);
    }
  }

  async function deleteMessage(messageId) {
    if (!confirm('Delete this message?')) return;
    try {
      const res = await fetch(`/api/groups/${encodeURIComponent(groupName)}/messages/${messageId}`, { method: 'DELETE' });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Could not delete');
      await loadMessages();
    } catch (err) {
      alert(err.message);
    }
  }

  async function hideMessage(messageId) {
    const reason = prompt('Reason for hiding:', 'This message was hidden because it broke the rules.');
    if (reason === null) return;
    try {
      const res = await fetch(`/api/groups/${encodeURIComponent(groupName)}/messages/${messageId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'hide', reason }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Could not hide');
      await loadMessages();
    } catch (err) {
      alert(err.message);
    }
  }

  async function reportMessage(messageId) {
    const reason = prompt('Report reason (optional):');
    if (reason === null) return;
    try {
      const res = await fetch(`/api/groups/${encodeURIComponent(groupName)}/messages/${messageId}/report`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Could not report');
      alert('Report sent.');
      await loadMessages();
    } catch (err) {
      alert(err.message);
    }
  }

  // Delegated actions on messages
  if (messagesEl) {
    messagesEl.addEventListener('click', (e) => {
      const btn = e.target.closest('button');
      if (!btn) return;
      if (btn.dataset.reply) { setReply(btn.dataset.reply); messageContent?.focus(); return; }
      if (btn.dataset.react) { openReactionPanel(Number(btn.dataset.react)); return; }
      if (btn.dataset.edit) { openEditForm(Number(btn.dataset.edit)); return; }
      if (btn.dataset.cancelEdit) { closeEditForm(Number(btn.dataset.cancelEdit)); return; }
      if (btn.dataset.delete) { deleteMessage(Number(btn.dataset.delete)); return; }
      if (btn.dataset.hide) { hideMessage(Number(btn.dataset.hide)); return; }
      if (btn.dataset.readMore) { toggleReadMore(Number(btn.dataset.readMore), btn); return; }
      if (btn.dataset.report) { reportMessage(Number(btn.dataset.report)); return; }
      if (btn.dataset.msgId && btn.dataset.emoji) { toggleReaction(Number(btn.dataset.msgId), btn.dataset.emoji); return; }
    });

    messagesEl.addEventListener('submit', async (e) => {
      const form = e.target.closest('.edit-form');
      if (!form) return;
      e.preventDefault();
      const messageId = Number(form.dataset.editForm);
      if (!messageId) return;
      const textarea = form.querySelector('.edit-textarea');
      const content = textarea?.value.trim();
      const errorEl = form.querySelector('.edit-error');
      if (!content) return;
      try {
        const res = await fetch(`/api/groups/${encodeURIComponent(groupName)}/messages/${messageId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'edit', content }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Could not update');
        closeEditForm(messageId);
        await loadMessages();
      } catch (err) {
        if (errorEl) {
          errorEl.textContent = err.message;
          errorEl.classList.remove('hidden');
        } else {
          alert(err.message);
        }
      }
    });
  }

  if (joinBtn) {
    joinBtn.addEventListener('click', async () => {
      try {
        const res = await fetch(`/api/groups/${encodeURIComponent(groupName)}/join`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Could not join');
        window.location.reload();
      } catch (err) {
        alert(err.message);
      }
    });
  }

  if (leaveBtn) {
    leaveBtn.addEventListener('click', async () => {
      if (role === 'creator' && !confirm('This will dissolve the group. Continue?')) return;
      try {
        const res = await fetch(`/api/groups/${encodeURIComponent(groupName)}/leave`, { method: 'POST' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Could not leave');
        if (data.dissolved) {
          window.location.href = '/spaces';
        } else {
          window.location.reload();
        }
      } catch (err) {
        alert(err.message);
      }
    });
  }

  document.querySelectorAll('.approve-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = btn.dataset.approve;
      if (!targetId) return;
      try {
        const res = await fetch(`/api/groups/${encodeURIComponent(groupName)}/approve`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target_id: targetId }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Could not approve');
        window.location.reload();
      } catch (err) {
        alert(err.message);
      }
    });
  });

  if (messageForm) {
    messageForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentUser) {
        window.location.href = '/login';
        return;
      }
      const content = messageContent.value.trim();
      const parentId = messageParentId.value ? Number(messageParentId.value) : null;
      if (!content) return;

      try {
        const res = await fetch(`/api/groups/${encodeURIComponent(groupName)}/messages`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content, parent_id: parentId }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Could not send message');
        messageContent.value = '';
        setReply('');
        await loadMessages();
      } catch (err) {
        if (messageError) {
          messageError.textContent = err.message;
          messageError.classList.remove('hidden');
        } else {
          alert(err.message);
        }
      }
    });
  }

  const reportsPanel = document.getElementById('reports-panel');
  if (reportsPanel) {
    reportsPanel.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-hide]');
      if (!btn || !btn.dataset.hide) return;
      hideMessage(Number(btn.dataset.hide));
      const li = btn.closest('li');
      if (li) li.remove();
    });
  }

  if (isMember) {
    loadMessages();
    setInterval(() => {
      if (!isInteracting()) loadMessages();
    }, 5000);
  }

</script>
