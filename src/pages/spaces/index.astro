---
import Layout from '../../layouts/Layout.astro';
import { getCurrentCurator } from '../../lib/auth';
import { getCuratorSubscriptions, type CuratorSubscription } from '../../lib/spaces';

const curator = await getCurrentCurator(Astro.cookies);
const subscriptions: CuratorSubscription[] = curator ? await getCuratorSubscriptions(curator.id) : [];
---

<Layout title="Openbin Spaces">
  <section class="flex-1 flex flex-col items-center justify-center p-4 sm:p-6">
    <div class="w-full max-w-sm border border-surface-light bg-surface p-6 shadow-sm">
      <div class="mb-6 flex items-center gap-3">
        <a href="/">
          <img src="/favicon.svg" alt="" class="h-8 w-8" />
        </a>
        <div>
          <h1 class="text-sm font-medium text-main">Spaces</h1>
          <p class="text-xs text-muted">Create or join a public pub/sub channel.</p>
        </div>
      </div>

      <form id="space-form" class="flex flex-col gap-3">
        <div class="flex gap-2">
          <input
            id="space-name"
            type="text"
            placeholder="myspace"
            required
            minlength="3"
            maxlength="64"
            pattern="[a-zA-Z0-9_-]{3,64}"
            title="3–64 letters, numbers, underscores or dashes"
            class="h-8 flex-1 border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
          />
          <button
            type="button"
            id="random-space"
            class="h-8 border border-surface-light bg-surface px-3 text-xs text-main transition hover:bg-surface-light"
            title="Generate a hard-to-guess name"
          >
            Random
          </button>
        </div>
        <p id="error" class="hidden text-xs text-red-400"></p>
        <button
          type="submit"
          class="h-8 border border-primary bg-primary px-3 text-xs font-medium text-white transition-colors hover:bg-primary/90"
        >
          Create / Join space
        </button>
      </form>

      <div class="mt-4 grid grid-cols-3 gap-2">
        <button
          type="button"
          id="create-blog-btn"
          class="h-8 border border-surface-light bg-surface px-2 text-xs text-main transition hover:bg-surface-light"
        >
          Create blog
        </button>
        <button
          type="button"
          id="create-forum-btn"
          class="h-8 border border-surface-light bg-surface px-2 text-xs text-main transition hover:bg-surface-light"
        >
          Create forum
        </button>
        <button
          type="button"
          id="create-group-btn"
          class="h-8 border border-surface-light bg-surface px-2 text-xs text-main transition hover:bg-surface-light"
        >
          Create group
        </button>
      </div>

      <div class="mt-4 border-t border-surface-light pt-4">
        <p class="text-xs font-medium text-main mb-2">Subscribe to an external feed</p>
        <div class="flex flex-col gap-2">
          <input
            id="rss-blog-name"
            type="text"
            placeholder="blog name"
            minlength="3"
            maxlength="64"
            pattern="[a-zA-Z0-9_-]{3,64}"
            title="3–64 letters, numbers, underscores or dashes"
            class="h-8 border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
          />
          <input
            id="rss-feed-url"
            type="url"
            placeholder="https://example.com/rss.xml"
            class="h-8 border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
          />
          <input
            id="rss-notification-space"
            type="text"
            placeholder="notification space"
            minlength="3"
            maxlength="64"
            pattern="[a-zA-Z0-9_-]{3,64}"
            title="3–64 letters, numbers, underscores or dashes"
            class="h-8 border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
          />
          <input
            id="rss-blog-title"
            type="text"
            placeholder="title (optional)"
            maxlength="200"
            class="h-8 border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
          />
          <div class="relative flex items-stretch">
            <input id="rss-format" type="hidden" value="rss" />
            <button
              type="button"
              id="rss-subscribe-btn"
              class="h-8 flex-1 border border-primary bg-primary px-3 text-xs font-medium text-white transition hover:bg-primary/90"
            >
              Subscribe to RSS feed
            </button>
            <button
              type="button"
              id="rss-dropdown-toggle"
              class="h-8 shrink-0 border-l border-white/20 bg-primary px-2 text-xs text-white transition hover:bg-primary/90"
              aria-label="Feed type"
            >
              ▼
            </button>
            <div
              id="rss-dropdown"
              class="hidden absolute right-0 top-full z-50 mt-1 w-48 border border-surface-light bg-surface py-1 shadow-lg"
            >
              <button
                type="button"
                data-rss-format="rss"
                class="w-full px-3 py-2 text-left text-xs text-main transition hover:bg-surface-light"
              >
                RSS feed
              </button>
              <button
                type="button"
                data-rss-format="atom"
                class="w-full px-3 py-2 text-left text-xs text-main transition hover:bg-surface-light"
              >
                Atom feed
              </button>
            </div>
          </div>
        </div>
        <p id="rss-error" class="hidden text-xs text-red-400 mt-1"></p>
      </div>

      <form id="blog-form" class="hidden mt-4 flex flex-col gap-3 border-t border-surface-light pt-4">
        <p class="text-xs font-medium text-main">Create a blog</p>
        <input
          id="blog-name"
          type="text"
          placeholder="myblog"
          required
          minlength="3"
          maxlength="64"
          pattern="[a-zA-Z0-9_-]{3,64}"
          title="3–64 letters, numbers, underscores or dashes"
          class="h-8 border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
        />
        <input
          id="blog-notification-space"
          type="text"
          placeholder="notification space (e.g. my-2fa)"
          required
          minlength="3"
          maxlength="64"
          pattern="[a-zA-Z0-9_-]{3,64}"
          class="h-8 border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
        />
        <input
          id="blog-title"
          type="text"
          placeholder="title (optional)"
          class="h-8 border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
        />
        <p id="blog-error" class="hidden text-xs text-red-400"></p>
        <button
          type="submit"
          class="h-8 border border-primary bg-primary px-3 text-xs font-medium text-white transition-colors hover:bg-primary/90"
        >
          Create blog
        </button>
      </form>

      <form id="forum-form" class="hidden mt-4 flex flex-col gap-3 border-t border-surface-light pt-4">
        <p class="text-xs font-medium text-main">Create a forum</p>
        <input
          id="forum-name"
          type="text"
          placeholder="myforum"
          required
          minlength="3"
          maxlength="64"
          pattern="[a-zA-Z0-9_-]{3,64}"
          title="3–64 letters, numbers, underscores or dashes"
          class="h-8 border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
        />
        <input
          id="forum-notification-space"
          type="text"
          placeholder="notification space (optional)"
          minlength="3"
          maxlength="64"
          pattern="[a-zA-Z0-9_-]{3,64}"
          title="3–64 letters, numbers, underscores or dashes"
          class="h-8 border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
        />
        <input
          id="forum-title"
          type="text"
          placeholder="title (optional)"
          class="h-8 border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
        />
        <p id="forum-error" class="hidden text-xs text-red-400"></p>
        <button
          type="submit"
          class="h-8 border border-primary bg-primary px-3 text-xs font-medium text-white transition-colors hover:bg-primary/90"
        >
          Create forum
        </button>
      </form>

      <form id="group-form" class="hidden mt-4 flex flex-col gap-3 border-t border-surface-light pt-4">
        <p class="text-xs font-medium text-main">Create a private group</p>
        <input
          id="group-name"
          type="text"
          placeholder="mygroup"
          required
          minlength="3"
          maxlength="64"
          pattern="[a-zA-Z0-9_-]{3,64}"
          title="3–64 letters, numbers, underscores or dashes"
          class="h-8 border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
        />
        <input
          id="group-title"
          type="text"
          placeholder="title (optional)"
          class="h-8 border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
        />
        <textarea
          id="group-description"
          rows="2"
          placeholder="welcome message (optional)"
          class="w-full border border-surface-light bg-background px-3 py-2 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none resize-none"
        ></textarea>
        <select
          id="group-access"
          class="h-8 border border-surface-light bg-background px-3 text-xs text-main focus:border-secondary focus:outline-none"
        >
          <option value="open">Anyone with the link can join</option>
          <option value="moderated">Require moderation</option>
        </select>
        <p id="group-error" class="hidden text-xs text-red-400"></p>
        <button
          type="submit"
          class="h-8 border border-primary bg-primary px-3 text-xs font-medium text-white transition-colors hover:bg-primary/90"
        >
          Create group
        </button>
      </form>

      <div class="mt-6 text-[10px] text-muted">
        <p class="mb-1">Publish from anywhere:</p>
        <code class="block text-main bg-background border border-surface-light p-2 break-all font-mono">
          curl -d "Backup successful" https://openbin.livrasand.com/s/myspace
        </code>
      </div>

      <div class="mt-6" id="subscribed-section">
        <p class="text-xs font-medium text-main mb-2">Subscriptions</p>
        <ul class="text-xs text-main" id="subscribed-spaces" data-logged-in={!!curator}>
          {subscriptions.length === 0 ? (
            <li class="text-muted" id="no-subscriptions">No subscriptions yet.</li>
          ) : (
            subscriptions.map((sub) => (
              <li class="flex items-center gap-2">
                <span class="text-[10px] text-muted uppercase">{sub.type}</span>
                <a href={sub.link} class="text-primary hover:underline">/{sub.name}</a>
                {sub.title && <span class="text-muted">· {sub.title}</span>}
              </li>
            ))
          )}
        </ul>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  const form = document.getElementById('space-form');
  const input = document.getElementById('space-name');
  const error = document.getElementById('error');
  const subscribedList = document.getElementById('subscribed-spaces');
  const randomSpaceBtn = document.getElementById('random-space');

  if (subscribedList && subscribedList.dataset.loggedIn !== 'true') {
    try {
      const subs = JSON.parse(localStorage.getItem('space:subs') || '[]');
      if (Array.isArray(subs) && subs.length > 0) {
        subscribedList.innerHTML = subs
          .map((name) => `<li><a href="/s/${encodeURIComponent(name)}" class="text-primary hover:underline">/${name}</a></li>`)
          .join('');
      }
    } catch {}
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = input.value.trim();
    if (!/^[a-zA-Z0-9_-]{3,64}$/.test(name)) {
      error.textContent = 'Use 3–64 letters, numbers, underscores or dashes.';
      error.classList.remove('hidden');
      return;
    }
    error.classList.add('hidden');
    window.location.href = `/s/${encodeURIComponent(name)}`;
  });

  if (randomSpaceBtn && input) {
    randomSpaceBtn.addEventListener('click', () => {
      const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
      let suffix = '';
      for (let i = 0; i < 12; i += 1) {
        suffix += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      input.value = `space-${suffix}`;
    });
  }

  const createBlogBtn = document.getElementById('create-blog-btn');
  const createForumBtn = document.getElementById('create-forum-btn');
  const createGroupBtn = document.getElementById('create-group-btn');
  const blogForm = document.getElementById('blog-form');
  const forumForm = document.getElementById('forum-form');
  const groupForm = document.getElementById('group-form');

  function toggleForm(show) {
    if (blogForm) blogForm.classList.add('hidden');
    if (forumForm) forumForm.classList.add('hidden');
    if (groupForm) groupForm.classList.add('hidden');
    if (show === 'blog' && blogForm) blogForm.classList.remove('hidden');
    if (show === 'forum' && forumForm) forumForm.classList.remove('hidden');
    if (show === 'group' && groupForm) groupForm.classList.remove('hidden');
  }

  if (createBlogBtn) createBlogBtn.addEventListener('click', () => toggleForm('blog'));
  if (createForumBtn) createForumBtn.addEventListener('click', () => toggleForm('forum'));
  if (createGroupBtn) createGroupBtn.addEventListener('click', () => toggleForm('group'));

  const blogNameInput = document.getElementById('blog-name');
  const blogNotificationInput = document.getElementById('blog-notification-space');
  const blogTitleInput = document.getElementById('blog-title');
  const blogError = document.getElementById('blog-error');

  if (blogForm) {
    blogForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = blogNameInput.value.trim();
      const notificationSpace = blogNotificationInput.value.trim();
      const title = blogTitleInput.value.trim() || null;

      if (!/^[a-zA-Z0-9_-]{3,64}$/.test(name) || !/^[a-zA-Z0-9_-]{3,64}$/.test(notificationSpace)) {
        blogError.textContent = 'Use 3–64 letters, numbers, underscores or dashes.';
        blogError.classList.remove('hidden');
        return;
      }

      try {
        const res = await fetch(`/api/blogs/${encodeURIComponent(name)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ notification_space: notificationSpace, title }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Could not create blog');
        window.location.href = `/blog/${encodeURIComponent(name)}`;
      } catch (err) {
        blogError.textContent = err.message;
        blogError.classList.remove('hidden');
      }
    });
  }

  const forumNameInput = document.getElementById('forum-name');
  const forumNotificationInput = document.getElementById('forum-notification-space');
  const forumTitleInput = document.getElementById('forum-title');
  const forumError = document.getElementById('forum-error');

  if (forumForm) {
    forumForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = forumNameInput.value.trim();
      const notificationSpace = forumNotificationInput.value.trim();
      const title = forumTitleInput.value.trim() || null;

      if (!/^[a-zA-Z0-9_-]{3,64}$/.test(name)) {
        forumError.textContent = 'Use 3–64 letters, numbers, underscores or dashes.';
        forumError.classList.remove('hidden');
        return;
      }
      if (notificationSpace && !/^[a-zA-Z0-9_-]{3,64}$/.test(notificationSpace)) {
        forumError.textContent = 'Notification space must be 3–64 letters, numbers, underscores or dashes.';
        forumError.classList.remove('hidden');
        return;
      }

      try {
        const res = await fetch(`/api/forums/${encodeURIComponent(name)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title,
            notification_space: notificationSpace || undefined,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Could not create forum');
        window.location.href = `/forum/${encodeURIComponent(name)}`;
      } catch (err) {
        forumError.textContent = err.message;
        forumError.classList.remove('hidden');
      }
    });
  }

  const groupNameInput = document.getElementById('group-name');
  const groupTitleInput = document.getElementById('group-title');
  const groupDescriptionInput = document.getElementById('group-description');
  const groupAccessInput = document.getElementById('group-access');
  const groupError = document.getElementById('group-error');

  if (groupForm) {
    groupForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = groupNameInput.value.trim();
      const title = groupTitleInput.value.trim() || null;
      const description = groupDescriptionInput.value.trim() || null;
      const access = groupAccessInput.value;

      if (!/^[a-zA-Z0-9_-]{3,64}$/.test(name)) {
        groupError.textContent = 'Use 3–64 letters, numbers, underscores or dashes.';
        groupError.classList.remove('hidden');
        return;
      }

      try {
        const res = await fetch(`/api/groups/${encodeURIComponent(name)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, description, access }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Could not create group');
        window.location.href = `/group/${encodeURIComponent(name)}`;
      } catch (err) {
        groupError.textContent = err.message;
        groupError.classList.remove('hidden');
      }
    });
  }

  const rssBlogInput = document.getElementById('rss-blog-name');
  const rssFeedUrlInput = document.getElementById('rss-feed-url');
  const rssNotificationSpaceInput = document.getElementById('rss-notification-space');
  const rssBlogTitleInput = document.getElementById('rss-blog-title');
  const rssSubscribeBtn = document.getElementById('rss-subscribe-btn');
  const rssDropdownToggle = document.getElementById('rss-dropdown-toggle');
  const rssDropdown = document.getElementById('rss-dropdown');
  const rssFormatInput = document.getElementById('rss-format');
  const rssError = document.getElementById('rss-error');

  const rssFormatLabels = {
    rss: 'Subscribe to RSS feed',
    atom: 'Subscribe to Atom feed',
  };

  function toggleRssDropdown(show) {
    if (rssDropdown) {
      if (show) rssDropdown.classList.remove('hidden');
      else rssDropdown.classList.add('hidden');
    }
  }

  if (rssDropdown) {
    rssDropdown.addEventListener('click', (e) => {
      const option = e.target.closest('[data-rss-format]');
      if (!option) return;
      const format = option.dataset.rssFormat;
      if (rssFormatInput) rssFormatInput.value = format;
      if (rssSubscribeBtn) rssSubscribeBtn.textContent = rssFormatLabels[format] || rssFormatLabels.rss;
      toggleRssDropdown(false);
    });
  }

  if (rssDropdownToggle) {
    rssDropdownToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = rssDropdown ? rssDropdown.classList.contains('hidden') : true;
      toggleRssDropdown(isHidden);
    });
  }

  if (rssSubscribeBtn) {
    rssSubscribeBtn.addEventListener('click', async () => {
      if (rssError) rssError.classList.add('hidden');
      const name = rssBlogInput?.value.trim() || '';
      const feedUrl = rssFeedUrlInput?.value.trim() || '';
      const notificationSpace = rssNotificationSpaceInput?.value.trim() || '';
      const title = rssBlogTitleInput?.value.trim() || null;

      if (!/^[a-zA-Z0-9_-]{3,64}$/.test(name)) {
        if (rssError) {
          rssError.textContent = 'Use 3–64 letters, numbers, underscores or dashes for the blog name.';
          rssError.classList.remove('hidden');
        }
        return;
      }
      if (!/^[a-zA-Z0-9_-]{3,64}$/.test(notificationSpace)) {
        if (rssError) {
          rssError.textContent = 'Use 3–64 letters, numbers, underscores or dashes for the notification space.';
          rssError.classList.remove('hidden');
        }
        return;
      }
      if (!/^https?:\/\/\S+/.test(feedUrl)) {
        if (rssError) {
          rssError.textContent = 'Enter a valid feed URL starting with http:// or https://.';
          rssError.classList.remove('hidden');
        }
        return;
      }

      try {
        const res = await fetch('/api/blogs/rss/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, feed_url: feedUrl, notification_space: notificationSpace, title }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Could not subscribe to feed');
        window.location.href = `/blog/${encodeURIComponent(name)}`;
      } catch (err) {
        if (rssError) {
          rssError.textContent = err.message;
          rssError.classList.remove('hidden');
        }
      }
    });
  }

  document.addEventListener('click', () => toggleRssDropdown(false));
</script>
