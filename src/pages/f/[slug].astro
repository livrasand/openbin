---
import Layout from '../../layouts/Layout.astro';
import CommentNode from '../../components/CommentNode.astro';
import { findBySlug, hasForks, markViewed, getCommentsBySlug, getVote, getVoteSummary } from '../../lib/db';
import type { CommentWithAuthor } from '../../lib/db';
import { getPublicURL } from '../../lib/utils';
import { codeToHtml } from 'shiki';
import { createHash } from 'node:crypto';
import { getCurrentCurator } from '../../lib/auth';

const { slug } = Astro.params;
if (typeof slug !== 'string' || slug.length === 0) {
  return new Response('Not found', { status: 404 });
}

const record = await findBySlug(slug);
if (!record) {
  return new Response('Not found', { status: 404 });
}

const now = new Date();
const expired = record.expires_at ? new Date(record.expires_at) <= now : false;

let unlocked = !record.password_hash;
let passwordError = false;
let password = '';

if (!expired && record.password_hash && Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  password = typeof formData.get('password') === 'string' ? String(formData.get('password')) : '';
  const hash = createHash('sha256').update(password).digest('hex');
  if (hash === record.password_hash) {
    unlocked = true;
  } else {
    passwordError = true;
  }
}

const directUrl = `https://ipfs.filebase.io/ipfs/${record.cid}`;
let code = '';
let html = '';

if (!expired && unlocked) {
  try {
    const response = await fetch(directUrl);
    if (response.ok) {
      code = await response.text();
    }
  } catch {
    code = '';
  }

  if (code && record.view_once) {
    await markViewed(record.slug);
  }

  const ext = record.filename.split('.').pop()?.toLowerCase() || 'text';
  function stripBackground(input: string): string {
    return input.replace(/background-color:\s*[^;]+;?/gi, '');
  }
  try {
    html = stripBackground(await codeToHtml(code, { lang: ext, theme: 'github-dark' }));
  } catch {
    html = stripBackground(await codeToHtml(code, { lang: 'text', theme: 'github-dark' }));
  }
}

const base = getPublicURL(Astro.request);
const publicUrl = `${base}/f/${record.slug}`;
const rawUrl = `${base}/raw/${record.slug}`;
const embedCode = `<iframe src="${publicUrl}" width="100%" height="300" style="border:1px solid #e5e7eb; border-radius:4px;" title="${record.filename.replace(/"/g, '&quot;')}" loading="lazy"></iframe>`;

const token = Astro.url.searchParams.get('token') || '';
const tokenHash = token ? createHash('sha256').update(token).digest('hex') : '';
const isAuthor = !!record.author_token && tokenHash === record.author_token;
const hasForksResult = await hasForks(slug);
const canEdit = isAuthor && !expired && !hasForksResult && (now.getTime() - new Date(record.created_at).getTime()) < 2 * 60 * 60 * 1000;

const curator = await getCurrentCurator(Astro.cookies);
const voteSummary = await getVoteSummary(slug);
const userVote = curator ? await getVote(curator.id, slug) : null;

const flatComments = await getCommentsBySlug(slug);

interface CommentNode extends CommentWithAuthor {
  replies: CommentNode[];
}

const commentMap = new Map<number, CommentNode>();
const rootComments: CommentNode[] = [];
for (const comment of flatComments) {
  const node: CommentNode = { ...comment, replies: [] };
  commentMap.set(node.id, node);
}
for (const comment of flatComments) {
  const node = commentMap.get(comment.id)!;
  if (comment.parent_id && commentMap.has(comment.parent_id)) {
    commentMap.get(comment.parent_id)!.replies.push(node);
  } else {
    rootComments.push(node);
  }
}

const authorUrl = record.curator_id && record.author ? `/u/${record.author}` : null;

function formatBytes(bytes: number): string {
  if (bytes === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(2))} ${sizes[i]}`;
}

function formatExpiry(value: string): string {
  const date = new Date(value);
  return `Expires on ${date.toLocaleString('en-US')}`;
}
---

<Layout title={`${record.filename} · openbin`}>
  <section class="flex flex-col flex-1 min-h-0 gap-4 overflow-hidden p-4 sm:p-6">
    <header class="flex shrink-0 flex-col border border-surface-light bg-surface shadow-sm">
      <div class="flex items-center justify-between gap-4 px-4 py-3">
        <div class="flex min-w-0 items-center gap-3">
          <a href="/">
            <img src="/favicon.svg" alt="" class="h-7 w-7 shrink-0" />
          </a>
          <div class="min-w-0">
            <p class="mb-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-primary">Openbin</p>
            <div class="flex items-center gap-2">
              <h1 class="truncate text-sm font-medium text-main">{record.filename}</h1>
              {record.hidden ? (
                <span class="inline-flex shrink-0 items-center border border-red-500/30 bg-red-500/10 px-1.5 py-0.5 text-[10px] font-medium text-red-400">
                  Hidden
                </span>
              ) : record.report_count >= 3 ? (
                <span
                  class="inline-flex shrink-0 items-center border border-primary/30 bg-primary/10 px-1.5 py-0.5 text-[10px] font-medium text-primary"
                  title="This file is under observation due to reports"
                >
                  Under observation
                </span>
              ) : null}
            </div>
            <p class="text-xs text-muted">
              {formatBytes(Number(record.size))} · {record.mime}
              {authorUrl ? (
                <span> · by <a href={authorUrl} class="text-primary hover:underline">{record.author}</a></span>
              ) : record.author ? (
                ` · by ${record.author}`
              ) : (
                ' · anonymous'
              )}
              {expired ? ' · expired' : record.expires_at ? ` · ${formatExpiry(record.expires_at)}` : ''}
            </p>
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <a href="/" class="h-8 border border-primary bg-primary px-3 py-2 text-xs font-medium text-white transition-colors hover:bg-primary/90">
            Create bin
          </a>
        </div>
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-2 border-t border-surface-light px-4 py-3">
        {unlocked && (
          <>
            <div class="flex items-center border border-surface-light bg-surface">
              <button
                type="button"
                id="vote-up"
                data-slug={record.slug}
                data-value="1"
                disabled={!curator}
                class={[
                  'h-8 px-2 text-xs font-medium transition-colors',
                  userVote?.value === 1 ? 'bg-primary/10 text-primary' : 'text-muted hover:text-main',
                  !curator && 'opacity-50 cursor-not-allowed',
                ].filter(Boolean).join(' ')}
                title={curator ? 'Upvote' : 'Login to vote'}
              >
                ▲
              </button>
              <span
                id="vote-score"
                class="min-w-[2rem] px-1 text-center text-xs font-medium text-main"
              >
                {voteSummary.score}
              </span>
              <button
                type="button"
                id="vote-down"
                data-slug={record.slug}
                data-value="-1"
                disabled={!curator}
                class={[
                  'h-8 px-2 text-xs font-medium transition-colors',
                  userVote?.value === -1 ? 'bg-red-500/10 text-red-400' : 'text-muted hover:text-main',
                  !curator && 'opacity-50 cursor-not-allowed',
                ].filter(Boolean).join(' ')}
                title={curator ? 'Downvote' : 'Login to vote'}
              >
                ▼
              </button>
            </div>
            <button
              type="button"
              data-url={publicUrl}
              class="h-8 border border-primary bg-primary px-3 text-xs font-medium text-white transition-colors hover:bg-primary/90"
            >
              Copy link
            </button>
            <a
              href={rawUrl}
              class="h-8 border border-surface-light bg-surface px-3 py-2 text-xs font-medium text-main transition-colors hover:bg-surface-light"
            >
              Raw
            </a>
            <a
              href={rawUrl}
              download={record.filename}
              class="h-8 border border-surface-light bg-surface px-3 py-2 text-xs font-medium text-main transition-colors hover:bg-surface-light"
            >
              Download
            </a>
            {curator ? (
              <a
                href={`/?fork=${record.slug}`}
                class="h-8 border border-surface-light bg-surface px-3 py-2 text-xs font-medium text-main transition-colors hover:bg-surface-light"
              >
                Fork
              </a>
            ) : (
              <button
                type="button"
                disabled
                class="h-8 cursor-not-allowed border border-surface-light bg-surface px-3 py-2 text-xs font-medium text-muted opacity-50"
                title="Login to fork"
              >
                Fork
              </button>
            )}
            {canEdit && (
              <>
                <a
                  href={`/?edit=${record.slug}&token=${encodeURIComponent(token)}`}
                  class="h-8 border border-surface-light bg-surface px-3 py-2 text-xs font-medium text-main transition-colors hover:bg-surface-light"
                >
                  Edit
                </a>
                <button
                  type="button"
                  data-delete
                  data-slug={record.slug}
                  data-token={token}
                  class="h-8 border border-red-500/30 bg-red-500/10 px-3 py-2 text-xs font-medium text-red-400 transition-colors hover:bg-red-500/20"
                >
                  Delete
                </button>
              </>
            )}
            <button
              type="button"
              id="embed-toggle"
              class="h-8 border border-surface-light bg-surface px-3 py-2 text-xs font-medium text-main transition-colors hover:bg-surface-light"
            >
              Embed
            </button>
            <div
              id="embed-panel"
              class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
              aria-modal="true"
              role="dialog"
            >
              <div class="w-full max-w-md border border-surface-light bg-surface p-5 shadow-lg">
                <div class="mb-3 flex items-center justify-between">
                  <h3 class="text-sm font-medium text-main">Embed code</h3>
                  <button
                    type="button"
                    id="embed-close"
                    class="text-xl leading-none text-muted hover:text-main"
                    aria-label="Close"
                  >
                    &times;
                  </button>
                </div>
                <div class="flex gap-2">
                  <input
                    type="text"
                    id="embed-code"
                    value={embedCode}
                    readonly
                    class="h-8 flex-1 border border-surface-light bg-background px-2 text-xs text-main focus:outline-none"
                  />
                  <button
                    type="button"
                    id="embed-copy"
                    class="h-8 border border-primary bg-primary px-3 text-xs font-medium text-white transition-colors hover:bg-primary/90"
                  >
                    Copy
                  </button>
                </div>
              </div>
            </div>
            <button
              type="button"
              id="report-btn"
              data-slug={record.slug}
              class="h-8 border border-surface-light bg-surface px-3 py-2 text-xs font-medium text-main transition-colors hover:bg-surface-light"
              >
              Report
            </button>
          </>
        )}
      </div>
    </header>

    <div class="flex-1 min-h-0 overflow-auto bg-background shadow-sm">
      {record.hidden ? (
        <div class="flex h-full flex-col items-center justify-center gap-2 p-6 text-center">
          <div class="flex h-10 w-10 items-center justify-center border border-red-500/30 bg-red-500/10 text-red-400">!</div>
          <p class="text-sm font-medium text-main">This bin has been hidden</p>
          <p class="text-xs text-muted">It received multiple reports and is no longer publicly visible.</p>
        </div>
      ) : expired ? (
        <div class="flex h-full flex-col items-center justify-center gap-2 p-6 text-center">
          <div class="flex h-10 w-10 items-center justify-center border border-surface-light bg-surface text-muted">!</div>
          <p class="text-sm font-medium text-main">This file has expired</p>
          <p class="text-xs text-muted">The content is no longer available.</p>
        </div>
      ) : !unlocked ? (
        <form method="POST" class="flex h-full flex-col items-center justify-center gap-4 p-6">
          <div class="flex max-w-sm flex-col items-center gap-2 text-center">
            <div class="flex h-10 w-10 items-center justify-center border border-secondary/30 bg-secondary/10 text-secondary">×</div>
            <h2 class="text-base font-medium text-main">This file is protected</h2>
            <p class="text-xs text-muted">Enter the password to view the content.</p>
          </div>
          {passwordError && <p class="border-l-2 border-red-400 px-2 text-xs text-red-400">Incorrect password</p>}
          <input
            type="password"
            name="password"
            placeholder="Password"
            value={password}
            class="h-8 w-full max-w-sm border border-surface-light bg-surface px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
          />
          <button
            type="submit"
            class="h-8 border border-primary bg-primary px-3 text-xs font-medium text-white transition-colors hover:bg-primary/90"
          >
            Unlock
          </button>
        </form>
      ) : html ? (
        <div class="min-h-full flex flex-col gap-6 p-4 sm:p-6">
          <div set:html={html}></div>
          <section class="border-t border-surface-light pt-6">
            <h2 class="mb-4 text-sm font-medium text-main">Comments ({flatComments.length})</h2>
            {curator ? (
              <form id="comment-form" data-slug={record.slug} class="mb-6 flex flex-col gap-2">
                <textarea
                  name="content"
                  rows="3"
                  placeholder="Write a comment..."
                  class="w-full border border-surface-light bg-surface p-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
                />
                <div class="flex items-center justify-between">
                  <p class="text-[10px] text-muted">Posting as @{curator.username}</p>
                  <button
                    type="button"
                    class="submit-comment h-8 border border-primary bg-primary px-3 text-xs font-medium text-white transition-colors hover:bg-primary/90"
                  >
                    Comment
                  </button>
                </div>
                <p class="error-msg hidden text-xs text-red-400"></p>
              </form>
            ) : (
              <p class="mb-6 text-xs text-muted">
                <a href="/create-account" class="text-primary hover:underline">Create an account</a>
                {' or '}
                <a href="/login" class="text-primary hover:underline">log in</a>
                {' to comment.'}
              </p>
            )}
            <div class="flex flex-col gap-4">
              {rootComments.length > 0 ? (
                rootComments.map((comment) => (
                  <CommentNode comment={comment} slug={record.slug} curator={!!curator} />
                ))
              ) : (
                <p class="text-xs text-muted">No comments yet.</p>
              )}
            </div>
          </section>
        </div>
      ) : (
        <div class="p-6 text-center text-muted">Could not load the content.</div>
      )}
    </div>
  </section>

  <div
    id="report-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
    aria-modal="true"
    role="dialog"
  >
    <div class="w-full max-w-sm border border-surface-light bg-surface p-5 shadow-lg">
      <h3 class="mb-2 text-sm font-medium text-main">Report file</h3>
      <p class="mb-4 text-xs text-muted">Are you sure you want to report this file?</p>
      <div class="flex justify-end gap-2">
        <button
          type="button"
          id="report-cancel"
          class="h-8 border border-surface-light bg-background px-3 text-xs font-medium text-main transition-colors hover:bg-surface-light"
        >
          Cancel
        </button>
        <button
          type="button"
          id="report-confirm"
          class="h-8 border border-red-500 bg-red-500 px-3 text-xs font-medium text-white transition-colors hover:bg-red-600"
        >
          Report
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  const button = document.querySelector('button[data-url]');
  if (button) {
    button.addEventListener('click', async () => {
      const url = button.getAttribute('data-url');
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        // ignore
      }
    });
  }

  const embedToggle = document.getElementById('embed-toggle');
  const embedPanel = document.getElementById('embed-panel');
  const embedClose = document.getElementById('embed-close');
  const embedCopy = document.getElementById('embed-copy');
  const embedInput = document.getElementById('embed-code');

  function openEmbedModal() {
    if (embedPanel) {
      embedPanel.classList.remove('hidden');
      embedPanel.classList.add('flex');
    }
  }

  function closeEmbedModal() {
    if (embedPanel) {
      embedPanel.classList.remove('flex');
      embedPanel.classList.add('hidden');
    }
  }

  if (embedToggle) {
    embedToggle.addEventListener('click', () => {
      openEmbedModal();
    });
  }

  if (embedClose) {
    embedClose.addEventListener('click', () => {
      closeEmbedModal();
    });
  }

  if (embedPanel) {
    embedPanel.addEventListener('click', (e) => {
      if (e.target === embedPanel) {
        closeEmbedModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeEmbedModal();
      }
    });
  }

  if (embedCopy && embedInput instanceof HTMLInputElement) {
    embedCopy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(embedInput.value);
      } catch {
        // ignore
      }
    });
  }

  const reportBtn = document.getElementById('report-btn');
  const reportModal = document.getElementById('report-modal');
  const reportConfirm = document.getElementById('report-confirm');
  const reportCancel = document.getElementById('report-cancel');

  function openReportModal() {
    if (reportModal) {
      reportModal.classList.remove('hidden');
      reportModal.classList.add('flex');
    }
  }

  function closeReportModal() {
    if (reportModal) {
      reportModal.classList.remove('flex');
      reportModal.classList.add('hidden');
    }
  }

  if (reportBtn && reportModal && reportConfirm && reportCancel) {
    const slug = reportBtn.getAttribute('data-slug');
    if (slug) {
      reportBtn.addEventListener('click', () => {
        openReportModal();
      });

      reportConfirm.addEventListener('click', async () => {
        closeReportModal();
        reportBtn.setAttribute('disabled', 'true');
        try {
          const res = await fetch('/api/report', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug }),
          });
          if (res.ok) {
            window.location.reload();
          } else {
            const data = await res.json().catch(() => ({}));
            reportBtn.textContent = data.error || 'Error';
          }
        } catch {
          reportBtn.textContent = 'Error';
        }
      });

      reportCancel.addEventListener('click', () => {
        closeReportModal();
      });

      reportModal.addEventListener('click', (e) => {
        if (e.target === reportModal) {
          closeReportModal();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeReportModal();
        }
      });
    }
  }

  const deleteBtn = document.querySelector('button[data-delete]');
  if (deleteBtn) {
    deleteBtn.addEventListener('click', async () => {
      const slug = deleteBtn.getAttribute('data-slug');
      const token = deleteBtn.getAttribute('data-token');
      if (!slug || !token) return;
      if (!confirm('Are you sure you want to delete this bin?')) return;
      try {
        const response = await fetch(`/api/files/${encodeURIComponent(slug)}?token=${encodeURIComponent(token)}`, {
          method: 'DELETE',
        });
        if (response.ok) {
          window.location.href = '/';
        } else {
          const data = await response.json().catch(() => ({ error: 'Could not delete' }));
          alert(data.error || 'Could not delete');
        }
      } catch {
        alert('Could not delete');
      }
    });
  }

  const voteUp = document.getElementById('vote-up') as HTMLButtonElement | null;
  const voteDown = document.getElementById('vote-down') as HTMLButtonElement | null;

  async function submitVote(button: HTMLButtonElement) {
    const slug = button.getAttribute('data-slug');
    const value = Number(button.getAttribute('data-value'));
    if (!slug || button.disabled) return;
    button.disabled = true;
    try {
      const res = await fetch('/api/votes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, value }),
      });
      if (res.ok) {
        window.location.reload();
      } else {
        button.disabled = false;
      }
    } catch {
      button.disabled = false;
    }
  }

  if (voteUp) voteUp.addEventListener('click', () => submitVote(voteUp));
  if (voteDown) voteDown.addEventListener('click', () => submitVote(voteDown));

  document.querySelectorAll('.reply-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const replyForm = btn.previousElementSibling;
      if (replyForm && replyForm.classList.contains('reply-form')) {
        replyForm.classList.toggle('hidden');
      }
    });
  });

  document.querySelectorAll('.cancel-reply').forEach((btn) => {
    btn.addEventListener('click', () => {
      const replyForm = btn.closest('.reply-form');
      if (replyForm) replyForm.classList.add('hidden');
    });
  });

  document.querySelectorAll('.submit-comment').forEach((button) => {
    button.addEventListener('click', async () => {
      const container = button.closest('#comment-form, .reply-form');
      if (!container) return;
      const slug = container.getAttribute('data-slug');
      const parentId = container.getAttribute('data-parent-id');
      const textarea = container.querySelector('textarea');
      const errorEl = container.querySelector('.error-msg');
      if (!slug || !textarea) return;

      const content = textarea.value.trim();
      if (!content) return;

      (button as HTMLButtonElement).disabled = true;
      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            slug,
            content,
            parent_id: parentId ? Number(parentId) : null,
          }),
        });
        if (res.ok) {
          window.location.reload();
        } else if (errorEl) {
          errorEl.classList.remove('hidden');
          errorEl.textContent = 'Could not post comment';
        }
      } catch {
        if (errorEl) {
          errorEl.classList.remove('hidden');
          errorEl.textContent = 'Could not post comment';
        }
      } finally {
        (button as HTMLButtonElement).disabled = false;
      }
    });
  });

  document.querySelectorAll('.report-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const form = btn.parentElement?.nextElementSibling;
      if (form && form.classList.contains('report-form')) {
        form.classList.toggle('hidden');
      }
    });
  });

  document.querySelectorAll('.cancel-report').forEach((btn) => {
    btn.addEventListener('click', () => {
      const form = btn.closest('.report-form');
      if (form) form.classList.add('hidden');
    });
  });

  document.querySelectorAll('.submit-report').forEach((button) => {
    button.addEventListener('click', async () => {
      const form = button.closest('.report-form');
      if (!form) return;
      const commentId = form.getAttribute('data-comment-id');
      const reasonSelect = form.querySelector('.report-reason') as HTMLSelectElement | null;
      const detailsTextarea = form.querySelector('textarea') as HTMLTextAreaElement | null;
      const errorEl = form.querySelector('.report-error');

      const reason = reasonSelect?.value.trim() ?? '';
      const details = detailsTextarea?.value.trim() ?? '';

      if (!reason) {
        if (errorEl) {
          errorEl.classList.remove('hidden');
          errorEl.textContent = 'Please select a reason';
        }
        return;
      }

      (button as HTMLButtonElement).disabled = true;
      try {
        const res = await fetch('/api/comments/reports', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            comment_id: commentId ? Number(commentId) : null,
            reason,
            details,
          }),
        });
        if (res.ok) {
          window.location.reload();
        } else if (errorEl) {
          errorEl.classList.remove('hidden');
          errorEl.textContent = 'Could not submit report';
        }
      } catch {
        if (errorEl) {
          errorEl.classList.remove('hidden');
          errorEl.textContent = 'Could not submit report';
        }
      } finally {
        (button as HTMLButtonElement).disabled = false;
      }
    });
  });
</script>
