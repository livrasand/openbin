---
import Layout from '../../layouts/Layout.astro';
import {
  findCuratorByUsername,
  getFollowCounts,
  getPublicBinsByCurator,
  countPublicBinsByCurator,
  isFollowing,
  getVotesByCuratorAndSlugs,
} from '../../lib/db';
import { getCurrentCurator } from '../../lib/auth';

const { username } = Astro.params;
if (typeof username !== 'string' || username.length === 0) {
  return new Response('Not found', { status: 404 });
}

const curator = await findCuratorByUsername(username);
if (!curator) {
  return new Response('Not found', { status: 404 });
}

const current = await getCurrentCurator(Astro.cookies);
const isOwnProfile = current?.id === curator.id;
const [counts, bins, binCount, following] = await Promise.all([
  getFollowCounts(curator.id),
  getPublicBinsByCurator(curator.id, 50),
  countPublicBinsByCurator(curator.id),
  current && !isOwnProfile ? isFollowing(current.id, curator.id) : Promise.resolve(false),
]);

const userVotes = current && bins.length > 0
  ? await getVotesByCuratorAndSlugs(current.id, bins.map((b) => b.slug))
  : {};

function formatBytes(bytes: number): string {
  if (bytes === 0) return '0 B';
  const k = 1024;
  const sizes = ['B', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(2))} ${sizes[i]}`;
}

function formatDate(value: string): string {
  return new Date(value).toLocaleString('en-US', {
    day: '2-digit',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
  });
}
---

<Layout title={`@${curator.username} · openbin`}>
  <section class="flex flex-1 flex-col gap-4 overflow-hidden p-4 sm:p-6">
    <header class="flex shrink-0 flex-col border border-surface-light bg-surface shadow-sm">
      <div class="flex items-center justify-between gap-4 px-4 py-3">
        <div class="flex min-w-0 items-center gap-3">
          <a href="/">
            <img src="/favicon.svg" alt="" class="h-7 w-7 shrink-0" />
          </a>
          <div class="min-w-0">
            <p class="mb-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-primary">Openbin</p>
            <h1 class="text-sm font-medium text-main">@{curator.username}</h1>
            <p class="text-xs text-muted">Level {curator.level} · {curator.karma} karma</p>
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <a href="/" class="h-8 border border-primary bg-primary px-3 py-2 text-xs font-medium text-white transition-colors hover:bg-primary/90">
            Create bin
          </a>
          {current && !isOwnProfile && (
            <button
              type="button"
              data-username={curator.username}
              data-following={String(following)}
              id="follow-btn"
              class="h-8 border border-surface-light bg-surface px-3 text-xs font-medium text-main transition-colors hover:bg-surface-light"
            >
              {following ? 'Following' : 'Follow'}
            </button>
          )}
        </div>
      </div>

      <div class="grid shrink-0 grid-cols-3 gap-3 border-t border-surface-light px-4 py-3">
      <div class="border border-surface-light bg-surface p-3 text-center">
        <p class="text-lg font-medium text-main">{binCount}</p>
        <p class="text-[10px] uppercase tracking-wide text-muted">Bins</p>
      </div>
      <div class="border border-surface-light bg-surface p-3 text-center">
        <p class="text-lg font-medium text-main">{counts.followers}</p>
        <p class="text-[10px] uppercase tracking-wide text-muted">Followers</p>
      </div>
      <div class="border border-surface-light bg-surface p-3 text-center">
        <p class="text-lg font-medium text-main">{counts.following}</p>
        <p class="text-[10px] uppercase tracking-wide text-muted">Following</p>
      </div>
    </div>
    </header>

    <main class="min-h-0 flex-1 overflow-auto bg-background shadow-sm sm:p-6">
      {bins.length > 0 ? (
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {bins.map((file) => {
            const upvoted = userVotes[file.slug] === 1;
            const downvoted = userVotes[file.slug] === -1;
            return (
              <article class="group flex flex-col border border-surface-light bg-surface p-4 transition-colors hover:border-primary/60 hover:bg-surface-light">
                <a href={`/f/${file.slug}`} class="block flex-1">
                  <div class="mb-4 flex items-start justify-between gap-3">
                    <div class="flex min-w-0 items-center gap-2">
                      <span class="flex h-7 w-7 shrink-0 items-center justify-center bg-primary/10 text-[10px] font-semibold uppercase text-primary">
                        {file.filename.split('.').pop()?.slice(0, 3) || 'txt'}
                      </span>
                      <h2 class="truncate text-sm font-medium text-main group-hover:text-primary">{file.filename}</h2>
                    </div>
                    <span class="shrink-0 text-[10px] text-muted">{formatBytes(Number(file.size))}</span>
                  </div>
                  <div class="flex items-center justify-between gap-2 border-t border-surface-light pt-3 text-xs text-muted">
                    <span>score {file.score}</span>
                    <span>{formatDate(file.created_at)}</span>
                  </div>
                </a>
                <div class="mt-3 flex items-center justify-between border-t border-surface-light pt-3">
                  <div class="flex items-center border border-surface-light bg-surface">
                    <button
                      type="button"
                      data-slug={file.slug}
                      data-value="1"
                      disabled={!current}
                      class={[
                        'vote-btn h-7 px-2 text-xs font-medium transition-colors',
                        upvoted ? 'bg-primary/10 text-primary' : 'text-muted hover:text-main',
                        !current && 'opacity-50 cursor-not-allowed',
                      ].filter(Boolean).join(' ')}
                      title={current ? 'Upvote' : 'Login to vote'}
                    >
                      ▲
                    </button>
                    <span class="min-w-[1.5rem] px-1 text-center text-xs font-medium text-main">{file.score}</span>
                    <button
                      type="button"
                      data-slug={file.slug}
                      data-value="-1"
                      disabled={!current}
                      class={[
                        'vote-btn h-7 px-2 text-xs font-medium transition-colors',
                        downvoted ? 'bg-red-500/10 text-red-400' : 'text-muted hover:text-main',
                        !current && 'opacity-50 cursor-not-allowed',
                      ].filter(Boolean).join(' ')}
                      title={current ? 'Downvote' : 'Login to vote'}
                    >
                      ▼
                    </button>
                  </div>
                  {file.language && <span class="text-[10px] text-muted">{file.language}</span>}
                  {file.report_count >= 3 && (
                    <span
                      class="inline-flex shrink-0 items-center border border-primary/30 bg-primary/10 px-1.5 py-0.5 text-[10px] font-medium text-primary"
                      title="This file is under observation due to reports"
                    >
                      Under observation
                    </span>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="flex h-full flex-col items-center justify-center gap-2 text-center">
          <div class="flex h-10 w-10 items-center justify-center border border-surface-light bg-surface text-muted">∅</div>
          <p class="text-sm font-medium text-main">No public bins yet</p>
          <p class="text-xs text-muted">This curator has not published anything.</p>
        </div>
      )}
    </main>
  </section>
</Layout>

<script>
  const followBtn = document.getElementById('follow-btn');
  if (followBtn) {
    const username = followBtn.getAttribute('data-username');
    followBtn.addEventListener('click', async () => {
      if (!username) return;
      followBtn.setAttribute('disabled', 'true');
      try {
        const res = await fetch('/api/follows', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          followBtn.removeAttribute('disabled');
        }
      } catch {
        followBtn.removeAttribute('disabled');
      }
    });
  }

  document.querySelectorAll('.vote-btn').forEach((button) => {
    button.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const btn = button as HTMLButtonElement;
      if (btn.disabled) return;
      const slug = btn.getAttribute('data-slug');
      const value = Number(btn.getAttribute('data-value'));
      if (!slug) return;
      btn.disabled = true;
      try {
        const res = await fetch('/api/votes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, value }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          btn.disabled = false;
        }
      } catch {
        btn.disabled = false;
      }
    });
  });
</script>
