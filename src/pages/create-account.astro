---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Create account · openbin">
  <section class="flex min-h-screen flex-col items-center justify-center p-4 sm:p-6">
    <div class="w-full max-w-sm border border-surface-light bg-surface p-6 shadow-sm">
      <div class="mb-6 flex items-center gap-3">
        <a href="/">
          <img src="/favicon.svg" alt="" class="h-8 w-8" />
        </a>
        <div>
          <h1 class="text-sm font-medium text-main">Create Curator account</h1>
        </div>
      </div>

      <form id="create-form" class="flex flex-col gap-3">
        <div>
          <label class="mb-1 block text-xs text-muted">Username (optional)</label>
          <input
            type="text"
            name="username"
            id="username"
            placeholder="anon-..."
            maxlength="30"
            class="h-8 w-full border border-surface-light bg-background px-3 text-xs text-main placeholder:text-muted focus:border-secondary focus:outline-none"
          />
          <p class="mt-1 text-[10px] text-muted">Leave empty for an auto-generated anonymous username.</p>
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="h-8 border border-primary bg-primary px-3 text-xs font-medium text-white transition-colors hover:bg-primary/90"
        >
          Create account
        </button>

        <p id="error" class="hidden text-xs text-red-400"></p>
      </form>

      <div id="success" class="hidden flex-col gap-3">
        <div class="rounded border border-primary/30 bg-primary/10 p-3">
          <p class="mb-1 text-xs text-primary font-medium">Save this 16-digit code</p>
          <p class="text-[10px] text-muted">It is your only way to log in. We cannot show it again.</p>
          <div class="mt-2 flex items-center gap-2">
            <input
              id="code-display"
              type="text"
              readonly
              class="h-8 flex-1 border border-surface-light bg-background px-2 font-mono text-xs text-main focus:outline-none"
            />
            <button
              id="copy-btn"
              type="button"
              class="h-8 border border-surface-light bg-surface px-3 text-xs text-main transition-colors hover:bg-surface-light"
            >
              Copy
            </button>
          </div>
        </div>
        <a
          href="/"
          class="h-8 border border-primary bg-primary px-3 py-2 text-center text-xs font-medium text-white transition-colors hover:bg-primary/90"
        >
          Go to Openbin
        </a>
      </div>

      <p class="mt-4 text-center text-[10px] text-muted">
        Already have a code? <a href="/login" class="text-primary hover:underline">Log in</a>
      </p>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('create-form');
  const errorEl = document.getElementById('error');
  const successEl = document.getElementById('success');
  const codeInput = document.getElementById('code-display') as HTMLInputElement | null;
  const copyBtn = document.getElementById('copy-btn');
  const submitBtn = document.getElementById('submit-btn');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn) return;
      submitBtn.setAttribute('disabled', 'true');
      if (errorEl) errorEl.classList.add('hidden');

      const formData = new FormData(form as HTMLFormElement);
      const username = String(formData.get('username') || '').trim() || undefined;

      try {
        const res = await fetch('/api/curators', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          throw new Error(data.error || 'Could not create account');
        }

        if (codeInput) codeInput.value = data.code || '';
        if (successEl) successEl.classList.remove('hidden');
        if (successEl) successEl.classList.add('flex');
        form.classList.add('hidden');
      } catch (err: unknown) {
        if (errorEl) {
          errorEl.textContent = err instanceof Error ? err.message : 'Could not create account';
          errorEl.classList.remove('hidden');
        }
      } finally {
        submitBtn.removeAttribute('disabled');
      }
    });
  }

  if (copyBtn && codeInput) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(codeInput.value);
        copyBtn.textContent = 'Copied';
      } catch {
        // ignore
      }
    });
  }
</script>
