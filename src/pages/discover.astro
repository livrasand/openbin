---
import Layout from '../layouts/Layout.astro';
import {
  listPublicFiles,
  listPublicFilesPopular,
  listPublicFilesTrending,
  listPublicFilesByLanguage,
  getDistinctLanguages,
  getVotesByCuratorAndSlugs,
} from '../lib/db';
import { getCurrentCurator } from '../lib/auth';

const tab = Astro.url.searchParams.get('tab') || 'new';
const rawLang = Astro.url.searchParams.get('lang') || '';

const languages = await getDistinctLanguages();
const selectedLang = rawLang || languages[0] || '';

let files;
if (tab === 'popular') {
  files = await listPublicFilesPopular(50);
} else if (tab === 'trending') {
  files = await listPublicFilesTrending(50);
} else if (tab === 'language') {
  files = selectedLang ? await listPublicFilesByLanguage(selectedLang, 50) : await listPublicFiles(50);
} else {
  files = await listPublicFiles(50);
}

const curator = await getCurrentCurator(Astro.cookies);
const userVotes = curator ? await getVotesByCuratorAndSlugs(curator.id, files.map((f) => f.slug)) : {};

function formatBytes(bytes: number): string {
  if (bytes === 0) return '0 B';
  const units = ['B', 'KB', 'MB', 'GB'];
  const index = Math.floor(Math.log(bytes) / Math.log(1024));
  return `${parseFloat((bytes / Math.pow(1024, index)).toFixed(2))} ${units[index]}`;
}

function formatDate(value: string): string {
  return new Date(value).toLocaleString('en-US', {
    day: '2-digit',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
  });
}
---

<Layout title="Discover · openbin">
  <section class="flex flex-1 flex-col gap-4 overflow-hidden p-4 sm:p-6">
    <header class="flex shrink-0 flex-col border border-surface-light bg-surface shadow-sm">
      <div class="flex items-center justify-between gap-4 px-4 py-3">
        <div class="flex min-w-0 items-center gap-3">
          <a href="/">
            <img src="/favicon.svg" alt="" class="h-7 w-7 shrink-0" />
          </a>
          <div class="min-w-0">
            <p class="mb-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-primary">Openbin</p>
            <h1 class="text-sm font-medium text-main">Discover</h1>
            <p class="text-xs text-muted">Recent public bins</p>
          </div>
        </div>
        <a href="/" class="h-8 border border-primary bg-primary px-3 py-2 text-xs font-medium text-white transition-colors hover:bg-primary/90">
          Create bin
        </a>
      </div>

      <div class="flex shrink-0 items-center gap-2 overflow-x-auto border-t border-surface-light bg-surface px-4 py-2">
        <a
          href="?tab=new"
          class={[
            'h-7 px-3 py-1.5 text-xs font-medium transition-colors',
            tab === 'new' ? 'bg-primary/10 text-primary' : 'text-muted hover:bg-surface-light hover:text-main',
          ].join(' ')}
        >
          New
        </a>
        <a
          href="?tab=popular"
          class={[
            'h-7 px-3 py-1.5 text-xs font-medium transition-colors',
            tab === 'popular' ? 'bg-primary/10 text-primary' : 'text-muted hover:bg-surface-light hover:text-main',
          ].join(' ')}
        >
          Popular
        </a>
        <a
          href="?tab=trending"
          class={[
            'h-7 px-3 py-1.5 text-xs font-medium transition-colors',
            tab === 'trending' ? 'bg-primary/10 text-primary' : 'text-muted hover:bg-surface-light hover:text-main',
          ].join(' ')}
        >
          Trending
        </a>
        <a
          href={selectedLang ? `?tab=language&lang=${encodeURIComponent(selectedLang)}` : '?tab=language'}
          class={[
            'h-7 px-3 py-1.5 text-xs font-medium transition-colors',
            tab === 'language' ? 'bg-primary/10 text-primary' : 'text-muted hover:bg-surface-light hover:text-main',
          ].join(' ')}
        >
          Language
        </a>
        {tab === 'language' && languages.length > 0 && (
          <select
            id="language-select"
            class="h-7 border border-surface-light bg-background px-2 text-xs text-main focus:outline-none"
          >
            {languages.map((lang) => (
              <option value={lang} selected={lang === selectedLang}>{lang}</option>
            ))}
          </select>
        )}
      </div>
    </header>

    <main class="min-h-0 flex-1 overflow-auto bg-background shadow-sm sm:p-6">
      {files.length > 0 ? (
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {files.map((file) => {
            const upvoted = userVotes[file.slug] === 1;
            const downvoted = userVotes[file.slug] === -1;
            const isForm = file.filename.toLowerCase().endsWith('.jform');
            return (
              <article class="group flex flex-col border border-surface-light bg-surface p-4 transition-colors hover:border-primary/60 hover:bg-surface-light">
                <a href={`/f/${file.slug}`} class="block flex-1">
                  <div class="mb-4 flex items-start justify-between gap-3">
                    <div class="flex min-w-0 items-center gap-2">
                      <span class="flex h-7 w-7 shrink-0 items-center justify-center bg-primary/10 text-[10px] font-semibold uppercase text-primary">
                        {file.filename.split('.').pop()?.slice(0, 3) || 'txt'}
                      </span>
                      <h2 class="truncate text-sm font-medium text-main group-hover:text-primary">{file.filename}</h2>
                    </div>
                    <span class="shrink-0 text-[10px] text-muted">{formatBytes(Number(file.size))}</span>
                  </div>
                  <div class="flex items-center justify-between gap-2 border-t border-surface-light pt-3 text-xs text-muted">
                    <span>
                      {file.author ? (
                        <span>by <a href={`/u/${file.author}`} class="text-primary hover:underline">{file.author}</a></span>
                      ) : (
                        'anonymous'
                      )}
                    </span>
                    <span>{formatDate(file.created_at)}</span>
                  </div>
                </a>
                <div class="mt-3 flex items-center justify-between border-t border-surface-light pt-3">
                  <div class="flex items-center border border-surface-light bg-surface">
                    <button
                      type="button"
                      data-slug={file.slug}
                      data-value="1"
                      disabled={!curator}
                      class={[
                        'vote-btn h-7 px-2 text-xs font-medium transition-colors',
                        upvoted ? 'bg-primary/10 text-primary' : 'text-muted hover:text-main',
                        !curator && 'opacity-50 cursor-not-allowed',
                      ].filter(Boolean).join(' ')}
                      title={curator ? 'Upvote' : 'Login to vote'}
                    >
                      ▲
                    </button>
                    <span class="min-w-[1.5rem] px-1 text-center text-xs font-medium text-main">{file.score}</span>
                    <button
                      type="button"
                      data-slug={file.slug}
                      data-value="-1"
                      disabled={!curator}
                      class={[
                        'vote-btn h-7 px-2 text-xs font-medium transition-colors',
                        downvoted ? 'bg-red-500/10 text-red-400' : 'text-muted hover:text-main',
                        !curator && 'opacity-50 cursor-not-allowed',
                      ].filter(Boolean).join(' ')}
                      title={curator ? 'Downvote' : 'Login to vote'}
                    >
                      ▼
                    </button>
                  </div>
                  <div class="flex items-center gap-2">
                    {isForm && (
                      <a
                        href={`/forms/${file.slug}`}
                        class="flex h-6 items-center border border-primary bg-primary px-2 text-[10px] font-medium text-white transition-colors hover:bg-primary/90"
                      >
                        Open form
                      </a>
                    )}
                    {file.language && <span class="text-[10px] text-muted">{file.language}</span>}
                  </div>
                  {file.report_count >= 3 && (
                    <span
                      class="inline-flex shrink-0 items-center border border-primary/30 bg-primary/10 px-1.5 py-0.5 text-[10px] font-medium text-primary"
                      title="This file is under observation due to reports"
                    >
                      Under observation
                    </span>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="flex h-full flex-col items-center justify-center gap-2 text-center">
          <div class="flex h-10 w-10 items-center justify-center border border-surface-light bg-surface text-muted">∅</div>
          <p class="text-sm font-medium text-main">No public bins yet</p>
          <p class="text-xs text-muted">Create a bin without a password to see it here.</p>
        </div>
      )}
    </main>
  </section>
</Layout>

<script>
  const languageSelect = document.getElementById('language-select');
  if (languageSelect) {
    languageSelect.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      window.location.href = `?tab=language&lang=${encodeURIComponent(target.value)}`;
    });
  }

  document.querySelectorAll('.vote-btn').forEach((button) => {
    button.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const btn = button as HTMLButtonElement;
      if (btn.disabled) return;
      const slug = btn.getAttribute('data-slug');
      const value = Number(btn.getAttribute('data-value'));
      if (!slug) return;
      btn.disabled = true;
      try {
        const res = await fetch('/api/votes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, value }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          btn.disabled = false;
        }
      } catch {
        btn.disabled = false;
      }
    });
  });
</script>
